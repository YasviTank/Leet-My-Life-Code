class Solution:
    def pattern17(self, n):
        start = ord("A")

        for i in range(1, n + 1):
            print(" " * (n - i), end="")

            for j in range(i):
                print(chr(start + j), end="")

            for j in range(i - 2, -1, -1):
                print(chr(start + j), end="")

            print()

