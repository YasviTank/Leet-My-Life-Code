class Solution:
    def selectionSort(self, nums):
        i = 0
        while i<len(nums):
            smallest = i
            for j in range(i,len(nums)):
                if nums[j] < nums[smallest]:
                    smallest = j

            nums[i], nums[smallest] = nums[smallest], nums[i]
            i += 1

        return nums

            0*O(n)
# Time complexity: O(n^2), two nested loops, outer loop:O(n), inner loop:O(n), therefore O(n)*o(n) = O(n^2)
# Space complexity: O(1), only extra variales used
