class Solution:
    def pattern19(self, n):
        for stars in range(n, 0, -1):
            spaces = 2 * (n - stars)
            print("*" * stars + " " * spaces + "*" * stars)

        for stars in range(1, n + 1):
            spaces = 2 * (n - stars)
            print("*" * stars + " " * spaces + "*" * stars)

