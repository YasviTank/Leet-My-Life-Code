class Solution:
    def LCM(self, n1, n2):
        larger = n2
        smaller = n1
        if n1 > n2:
            larger = n1
            smaller = n2

        i = 1
        while True:
            if ((larger*i) % smaller) == 0:
                return larger*i
            i += 1

