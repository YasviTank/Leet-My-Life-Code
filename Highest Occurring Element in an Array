class Solution:
    def mostFrequentElement(self, nums):
        count = {}
        highest = 1

        nums = sorted(nums)

        for num in nums:
            if num in count:
                count[num] += 1
                if count[num] > highest:
                    highest = count[num]
            else:
                count[num] = 1

        for key in count:
            if count[key] == highest:
                return key

      
