class Solution:    
    def palindromeCheck(self, s):
        #your code goes here
        def helper(left, right):
            # Base case: all characters matched
            if left >= right:
                return True

            # Mismatch means not a palindrome
            if s[left] != s[right]:
                return False

            # Recursive call, passing the result back
            return helper(left + 1, right - 1)

        return helper(0, len(s) - 1)
