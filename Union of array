
class Solution:
    def unionArray(self, nums1, nums2):
        i = j = 0
        n, m = len(nums1), len(nums2)
        ans = []

        while i < n or j < m:
            if j == m or (i < n and nums1[i] <= nums2[j]):
                val = nums1[i]
                i += 1
            else:
                val = nums2[j]
                j += 1

            if not ans or ans[-1] != val:
                ans.append(val)

        return ans
