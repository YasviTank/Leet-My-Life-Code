class Solution:
    def reverseString(self,s):
        #your code goes here
        def helper(left, right):

            if left >= right:
                return ""
            
            else:
                s[left], s[right] = s[right], s[left]
                helper(left+1, right-1)

        helper(0, len(s)-1)
        return s

        ## Another way (using recursion):
        # Base case
        if len(s) <= 1:
            return s

        # Last element + reversed middle + first element
        return [s[-1]] + self.reverseString(s[1:-1]) + [s[0]]
            
