class Solution:
    def lowerBound(self, nums, x):
        low = 0
        high = len(nums) - 1
        answer = len(nums)

        while low <= high:
            mid = (low + high) // 2

            if nums[mid] < x:
                low = mid + 1
            else:
                answer = mid
                high = mid - 1

        return answer
