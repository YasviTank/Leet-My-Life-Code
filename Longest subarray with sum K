class Solution:
    def longestSubarray(self, nums, k):
        longest = 0
        total = 0
        left = 0
        right = 0

        while right < len(nums):
            total += nums[right]

            while left <= right and total > k:
                total -= nums[left]
                left += 1

            if total == k:
                longest = max(longest, right - left + 1)

            right += 1

        return longest
