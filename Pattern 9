class Solution:
    def pattern9(self, n):
        # Upper pyramid
        for i in range(n):
            print(" " * (n-i-1) + "*" * (2*i+1))

        # Lower inverted pyramid
        for i in range(n, 0, -1):
            print(" " * (n-i) + "*" * (2*i-1))

